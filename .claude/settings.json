{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | grep -q 'CLAUDE\\.md$' && cp /home/darkiop/dev/ansible/CLAUDE.md /home/darkiop/dev/ansible/AGENTS.md 2>/dev/null || true",
            "statusMessage": "Syncing CLAUDE.md -> AGENTS.md..."
          }
        ]
      }
    ]
  }
}
